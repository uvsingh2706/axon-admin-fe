# ── API Base URLs ────────────────────────────────────────────────
# If all services share one URL, just set VITE_API_BASE_URL.
# For microservices, set individual URLs as needed.

VITE_API_BASE_URL=http://localhost:3000/api
VITE_AUTH_API_URL=http://localhost:3001/api
VITE_STATIONS_API_URL=http://localhost:3002/api
VITE_SESSIONS_API_URL=http://localhost:3003/api

# ── White Label / Branding ───────────────────────────────────────
# Built-in platforms: axon | demo
VITE_PLATFORM=axon

# Optional runtime overrides (override selected platform config)
# VITE_BRAND_LOGO_URL=https://dummyimage.com/240x80/2563eb/ffffff.png&text=Acme+EV
# VITE_BRAND_DISPLAY_NAME=Acme EV
# VITE_BRAND_FONT_FAMILY='Urbanist', sans-serif
# VITE_BRAND_PRIMARY_COLOR=#2563EB
# VITE_BRAND_PRIMARY_LIGHT_COLOR=#DBEAFE
